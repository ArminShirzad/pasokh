# Pasokh settings. The installer writes this file for you; edit it only if you
# know what you are changing, then run `docker compose up -d` again.

# ── Required ─────────────────────────────────────────────────────────────────
# Long random secrets (the installer generates them): openssl rand -hex 32
NEXTAUTH_SECRET=
CRON_SECRET=
# Encrypts stored Instagram/Zernio keys. Never change it after the first start,
# or saved connections can no longer be read.
ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# ── How the world reaches this server ───────────────────────────────────────
# One of: quick | domain | cloudflare | (empty for local only)
COMPOSE_PROFILES=quick
# quick tunnel: the public URL is discovered automatically; leave PASOKH_TUNNEL=quick.
PASOKH_TUNNEL=quick
# domain / cloudflare: the public address, with https://
NEXTAUTH_URL=http://localhost:3000
# domain profile only: the bare domain Caddy gets a certificate for.
# PASOKH_DOMAIN=pasokh.example.com
# cloudflare profile only: the tunnel token from the Cloudflare dashboard.
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Interface ───────────────────────────────────────────────────────────────
# fa (Persian, right-to-left) or en. Each person can still switch in the app.
DEFAULT_LOCALE=fa
TZ=Asia/Tehran

# ── Optional: email ─────────────────────────────────────────────────────────
# Not needed to sign in (Pasokh uses passwords). Set one of these to also offer
# one-time sign-in links by email.
# EMAIL_SERVER=smtps://user%40example.com:password@mail.example.com:465
# RESEND_API_KEY=re_...
# EMAIL_FROM=Pasokh <login@example.com>

# ── Optional: restrict who can sign in ──────────────────────────────────────
# Comma separated. Accounts are created only by setup and invitations anyway.
# ALLOWED_EMAILS=you@example.com

# ── Optional: your own Meta app (instead of, or alongside, Zernio) ──────────
# See docs/setup.md. Needed for live-video comments.
# META_GRAPH_API_VERSION=v25.0
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# FACEBOOK_APP_SECRET=
# WEBHOOK_VERIFY_TOKEN=

# ── Advanced ────────────────────────────────────────────────────────────────
# Pin a release instead of following latest: ghcr.io/arminshirzad/pasokh:v0.1.0
# PASOKH_IMAGE=ghcr.io/arminshirzad/pasokh:latest
# Publish the web port beyond this machine (e.g. 0.0.0.0) and change it.
# PASOKH_BIND=127.0.0.1
# PASOKH_PORT=3000
